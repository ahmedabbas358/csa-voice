# ============================================================
# ملف متغيرات البيئة لمنصة انتخابات جمعية الحاسوب (IUA CSA)
# انسخ هذا الملف إلى .env وعدّل القيم حسب خادم الإنتاج الخاص بك
# ============================================================

# منفذ وعنوان الخادم
PORT=3000
HOST=0.0.0.0

# مسار لوحة التحكم الرئاسية السري (خصّصه وفق رغبتك)
ADMIN_PATH=/csa-admin-panel

# كلمة المرور المخصصة لغرفة الرئاسة
ADMIN_PASSWORD=ChangeMe_StrongPassword123!

# تفعيل رؤوس HSTS المشددة عند توفير شهادة SSL/TLS
HTTPS=0

# النطاقات المسموح لها بإجراء طلبات CORS (مفصولة بفواصل، اتركه فارغاً للاقتصار على نفس الأصل)
# ALLOWED_ORIGINS=https://csa-election.iua.edu.sd
